{
  "name": "blindspot", "version": "0.1.0", "private": true, "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @blindspot/server\" \"npm run dev -w @blindspot/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test tests/*.test.ts",
    "start": "npm run start -w @blindspot/server",
    "browser:install": "playwright install chromium"
  },
  "devDependencies": { "@types/node": "^22.0.0", "concurrently": "^9.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "playwright": "^1.55.0" },
  "overrides": { "uuid": "^11.1.1" }
}
