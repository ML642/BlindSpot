{
  "name": "@blindspot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker-entry.ts"
  },
  "dependencies": {
    "@blindspot/shared": "0.1.0",
    "@blindspot/playbooks": "0.1.0",
    "@axe-core/playwright": "^4.10.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^10.1.3",
    "@google-cloud/storage": "^8.1.0",
    "@google/genai": "^1.16.0",
    "fastify": "^5.4.0",
    "google-auth-library": "^10.6.2",
    "playwright": "^1.55.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
