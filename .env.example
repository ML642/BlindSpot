# Copy to .env at the repository root. This file contains no credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=3001
HOST=127.0.0.1
BLINDSPOT_EXECUTION_MODE=local
BLINDSPOT_MAX_AUDIT_MINUTES=10
BLINDSPOT_MAX_ACTIONS=30
BLINDSPOT_MAX_PAGE_STATES=5
BLINDSPOT_MAX_SPECIALISTS=3

# Optional: run npm run fixtures and allow exactly this local fixture entrypoint.
# This bypass is disabled in GCP. Never use it for arbitrary private sites.
# BLINDSPOT_DEMO_TARGET=http://127.0.0.1:4174/login-modal.html

# Required only for GCP mode:
# GCP_PROJECT=your-project
# GCP_REGION=europe-central2
# GCP_JOB_NAME=blindspot-worker
# GCS_BUCKET=your-project-blindspot
