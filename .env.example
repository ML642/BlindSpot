# Copy to .env at the repository root. Never put credentials in this template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=3001
HOST=127.0.0.1
BLINDSPOT_EXECUTION_MODE=local
BLINDSPOT_MAX_AUDIT_MINUTES=10
# Optional override. Defaults to 15 in GCP and 2 locally.
# BLINDSPOT_MAX_CONCURRENT_AUDITS=15
BLINDSPOT_MAX_ACTIONS=30
BLINDSPOT_MAX_PAGE_STATES=5
BLINDSPOT_MAX_SPECIALISTS=3

# Optional local test fixture; disabled in GCP.
# BLINDSPOT_DEMO_TARGET=http://127.0.0.1:4174/login-modal.html

# Required only for GCP mode:
# GCP_PROJECT=your-project-id
# GCP_REGION=europe-central2
# GCP_JOB_NAME=blindspot-worker
# GCS_BUCKET=your-project-id-blindspot
